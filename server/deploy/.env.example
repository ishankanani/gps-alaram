# StopWake Cloud environment (VPS / docker run --env-file). Secrets: never commit the real file.
NODE_ENV=production
PUBLIC_URL=https://api.example.com
TRUST_PROXY=1

# First admin (password at least 12 characters). Remove ADMIN_PASSWORD after the first start if you like.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# RevenueCat: webhook secret (openssl rand -hex 32) and, optionally, the v1 secret API key.
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=

# Mail (password reset codes): smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465
SMTP_URL=
MAIL_FROM=StopWake <no-reply@example.com>
SUPPORT_EMAIL=support@example.com
